<Window x:Class="NetScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetScope Network Discovery Tool" MinWidth="600" MinHeight="400"
        Icon="pack://application:,,,/icon.ico"
        WindowStartupLocation="CenterScreen" FontSize="13"
        StateChanged="Window_StateChanged">

  <!-- 禁用态视觉反馈：降低透明度，与可用状态明显区分（滑块/文字等默认禁用样式不明显的元素） -->
  <Window.Resources>
    <Style TargetType="Slider">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid x:Name="LayoutRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 顶部：网卡 + 扫描方式 + 状态徽章 -->
    <Border Grid.Row="0" Padding="12" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock x:Name="LblAdapter" Text="Adapter" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
          <ComboBox x:Name="CmbAdapter" Width="300" VerticalContentAlignment="Center"
                    SelectionChanged="CmbAdapter_SelectionChanged"/>
          <Button x:Name="BtnRefreshAdapter" Content="Refresh" Margin="8,0,0,0" Padding="10,3"
                  Click="BtnRefreshAdapter_Click"/>
          <TextBlock x:Name="TxtAdapterInfo" VerticalAlignment="Center" Margin="12,0,0,0"
                     Foreground="Gray" FontSize="13"/>
        </StackPanel>
        <Border Grid.Column="1" x:Name="BadgeState" Background="#E5E5E5" CornerRadius="4"
                Padding="10,3" VerticalAlignment="Center">
          <TextBlock x:Name="TxtState" Text="Idle" Foreground="#333" FontWeight="Bold" FontSize="13"/>
        </Border>
      </Grid>
    </Border>

    <!-- 中间：左侧结果 + 右侧侧栏 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 左侧结果表 -->
      <Border Grid.Column="0" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
            <TextBlock x:Name="TxtResultHeader" Text="Results: 0" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtProgress" Text="" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="Gray" FontSize="13"/>
          </StackPanel>
          <DataGrid Grid.Row="1" x:Name="DgResults"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    AlternatingRowBackground="#F9F9F9"
                    HeadersVisibility="Column"
                    CanUserAddRows="False" CanUserDeleteRows="False"
                    LoadingRow="DgResults_LoadingRow"
                    SelectionChanged="DgResults_SelectionChanged"
                    MouseDoubleClick="DgResults_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="IPv4" Binding="{Binding Ip}" Width="20*"/>
              <DataGridTextColumn Header="MAC / Vendor" Width="30*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
                <DataGridTextColumn.Binding>
                  <MultiBinding StringFormat="{}{0}&#10;{1}">
                    <Binding Path="MacText"/>
                    <Binding Path="Vendor"/>
                  </MultiBinding>
                </DataGridTextColumn.Binding>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Device / Host Name" Width="30*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
                <DataGridTextColumn.Binding>
                  <MultiBinding StringFormat="{}{0}&#10;{1}">
                    <Binding Path="DeviceName"/>
                    <Binding Path="HostName"/>
                  </MultiBinding>
                </DataGridTextColumn.Binding>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="20*"/>
              <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="10*"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,4,8,8">
            <Button x:Name="BtnClear" Content="Clear Results" Padding="12,4"
                    Click="BtnClear_Click" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtPacketCount" Text="Captured 0 frames" VerticalAlignment="Center"
                       Foreground="Gray" FontSize="13"/>
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

      <!-- 右侧侧栏 -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <!-- 发现选项 -->
          <GroupBox x:Name="GrpDiscovery" Header="Discovery Options" Padding="8" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <StackPanel.Resources>
                  <Style x:Key="SegBtn" TargetType="RadioButton">
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                          <Border x:Name="Bd" Background="#F2F2F2" BorderBrush="#CFCFCF"
                                  BorderThickness="1" CornerRadius="4" Padding="14,5"
                                  SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="#E4E4E4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="#1E6FD9"/>
                              <Setter TargetName="Bd" Property="BorderBrush" Value="#1B62BE"/>
                              <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </StackPanel.Resources>
                <RadioButton x:Name="RbActive" Content="Active Scan" GroupName="ScanMode"
                             Style="{StaticResource SegBtn}" Margin="0,0,2,0" Checked="RbScanMode_Checked"/>
                <RadioButton x:Name="RbPassive" Content="Passive Listen" GroupName="ScanMode"
                             Style="{StaticResource SegBtn}" IsChecked="True" Checked="RbScanMode_Checked"/>
              </StackPanel>

              <!-- F24：DCP 勾选开关（仅 Active 模式下可勾选） -->
              <CheckBox x:Name="CbDcp" Content="Enable PROFINET DCP" FontSize="13"
                        Margin="0,8,0,0" IsEnabled="False"
                        Checked="CbDcp_CheckedChanged" Unchecked="CbDcp_CheckedChanged"/>

              <TextBlock Text="Send Interval (ms)" FontWeight="SemiBold" Margin="0,8,0,4"/>
              <Slider x:Name="SliderInterval" Minimum="15" Maximum="90" Value="15" TickFrequency="15"
                      IsSnapToTickEnabled="True" Width="200" HorizontalAlignment="Left"
                      ValueChanged="SliderInterval_ValueChanged"/>
              <TextBlock x:Name="TxtInterval" Text="15 ms" Foreground="Gray" FontSize="13"/>
            </StackPanel>
          </GroupBox>

          <!-- 扫描控制 -->
          <GroupBox Header="Scan Control" Padding="8" Margin="0,0,0,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnStart" Content="Start" Width="86" Margin="0,0,6,0"
                        Click="BtnStart_Click"/>
                <Button x:Name="BtnPause" Content="Pause" Width="86" Margin="0,0,6,0"
                        IsEnabled="False" Click="BtnPause_Click"/>
                <Button x:Name="BtnStop" Content="Stop" Width="86" Margin="0,0,6,0"
                        IsEnabled="False" Click="BtnStop_Click"/>
              </StackPanel>
              <ProgressBar x:Name="PbOverall" Height="6" Margin="0,10,0,0" Maximum="100" Value="0"/>
              <TextBlock x:Name="TxtEta" Text="" FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
            </StackPanel>
          </GroupBox>

          <!-- 设备通信 / 改址 -->
          <GroupBox x:Name="GrpComm" Header="Device Access" Padding="8">
            <StackPanel>
              <Button x:Name="BtnJoinSubnet" Content="Join Device Subnet" Padding="8,4" Margin="0,0,0,8"
                      Click="BtnJoinSubnet_Click" IsEnabled="False"/>
              <TextBlock Text="Manual Settings" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtSetIp" Margin="0,0,0,4" TextChanged="ManualField_TextChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mask" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSetMask" Text="255.255.255.0" Margin="0,0,0,4" TextChanged="ManualField_TextChanged"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Gateway" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtSetGw" Margin="0,0,0,4" TextChanged="ManualField_TextChanged"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="DNS" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtSetDns" Margin="0,0,0,4" TextChanged="ManualField_TextChanged"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="BtnApplyIp" Content="Apply" Width="72" Margin="0,0,6,0"
                        Click="BtnApplyIp_Click" IsEnabled="False"/>
                <Button x:Name="BtnRestoreDhcp" Content="Restore" Width="96"
                        Click="BtnRestoreDhcp_Click" IsEnabled="False"/>
              </StackPanel>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 底部状态栏 -->
    <StatusBar Grid.Row="2">
      <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StatusBar}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TxtStatusBar" Text="Ready" Margin="4,0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtContact" Text="ming.tec@foxmail.com" Margin="8,0" Grid.Column="1"
                   Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
      </Grid>
    </StatusBar>
  </Grid>
</Window>
